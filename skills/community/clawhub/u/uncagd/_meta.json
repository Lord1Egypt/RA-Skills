{
  "name": "uncagd",
  "package": "@uncagd/openclaw-cag-memory",
  "version": "1.0.0",
  "mcpServer": {
    "name": "uncagd-memory",
    "command": "uncagd",
    "args": ["start"]
  },
  "tools": [
    "cag.capture_candidate",
    "cag.validate_memory",
    "cag.retrieve",
    "cag.list_candidates",
    "cag.reject_memory",
    "cag.check_contradictions",
    "cag.export_memory",
    "cag.import_memory",
    "cag.compress_memory",
    "cag.resolve_contradiction"
  ]
}
