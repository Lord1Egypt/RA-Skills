{
  "name": "compliance-checker",
  "version": "1.1.6",
  "type": "python",
  "install": "pip install compliance-checker",
  "entrypoint": "compliance-checker",
  "description": "项目手续合规审查 Python 库",
  "author": "evob",
  "tags": ["compliance", "document-check", "python", "ocr", "pdf"],
  "license": "MIT",
  "requires": {
    "bins": ["python", "pip", "compliance-checker"]
  },
  "secrets": {
    "supported": true,
    "description": "支持 OpenClaw SecretRef 规范进行密钥管理",
    "providers": ["env", "file", "exec"],
    "required_keys": ["llm_api_key"],
    "optional_keys": [
      "llm_base_url",
      "llm_model",
      "llm_timeout",
      "llm_max_retries",
      "embed_api_key",
      "embed_base_url",
      "embed_model",
      "vision_api_key",
      "vision_base_url",
      "vision_model",
      "ocr_backend",
      "alibaba_cloud_access_key_id",
      "alibaba_cloud_access_key_secret"
    ]
  }
}