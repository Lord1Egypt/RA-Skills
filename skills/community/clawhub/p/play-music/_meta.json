{
  "name": "play-music",
  "version": "1.0.0",
  "description": "Play music files from local directory with pause/resume/stop support",
  "author": "Ana",
  "created": "2026-02-09",
  "platforms": ["windows", "macos", "linux"],
  "dependencies": {
    "python": "3.6+",
    "optional": ["pygame"]
  },
  "configuration": {
    "environment_variables": {
      "MUSIC_DIR": "Path to music directory (default: ./music)",
      "DEFAULT_SONG": "Default song filename (default: jaychou-sunnyday.mp3)",
      "MUSIC_LOCK_FILE": "Lock file path (default: /tmp/music_player.lock)"
    }
  }
}