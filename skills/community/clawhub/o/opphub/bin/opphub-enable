#!/usr/bin/env bash

# 路径解析（兼容容器/K8s/多环境）
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/opphub-paths.sh"
opphub_init_home
# 偶合 OppHub · 完成引导（注册流程如果中断，可用 enable 续）
set -e

OPPHUB_HOME="${OPPHUB_HOME:-}"  # ← 由 lib/opphub-paths.sh 解析后填入
API_BASE="${OPPHUB_API_BASE:-https://api.opphub.ruiplus.cn}"

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
RED='\033[0;31m'
NC='\033[0m'

step() { echo -e "${BLUE}━━━ $1 ━━━${NC}"; }
ok()   { echo -e "${GREEN}✓ $1${NC}"; }
warn() { echo -e "${YELLOW}⚠ $1${NC}"; }
fail() { echo -e "${RED}✗ $1${NC}"; exit 1; }

STATE="$OPPHUB_HOME/state.json"
[ ! -f "$STATE" ] && fail "未登录，请先 opphub login"

TOKEN=$(grep -o '"opphub_token":"[^"]*"' "$STATE" | cut -d'"' -f4)
OPC_ID=$(grep -o '"opc_id":"[^"]*"' "$STATE" | cut -d'"' -f4)

step "完成引导"

# 查服务端引导状态
RESP=$(curl -s "$API_BASE/api/onboarding/status" \
  -H "Authorization: Bearer $TOKEN")

STEP=$(echo "$RESP" | grep -o '"currentStep":[0-9]*' | cut -d':' -f2)

if [ "$STEP" = "6" ] || [ "$STEP" = "null" ] || [ -z "$STEP" ]; then
  ok "引导已完成"
  exit 0
fi

echo "您当前在引导第 $STEP 步"
echo "请重新跑：opphub register"
echo "或联系客服：hi@opphub.com"
