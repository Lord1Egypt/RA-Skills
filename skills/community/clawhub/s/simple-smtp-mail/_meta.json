{
  "name": "simple-smtp-mail",
  "description": "Send emails via SMTP using msmtp command-line tool",
  "version": "1.0.0",
  "author": "OpenClaw",
  "tags": ["email", "smtp", "msmtp"],
  "requires": {
    "bins": ["msmtp"]
  },
  "install": [
    {
      "id": "brew",
      "kind": "brew",
      "package": "msmtp",
      "label": "Install msmtp (macOS)"
    },
    {
      "id": "apt",
      "kind": "apt",
      "package": "msmtp",
      "label": "Install msmtp (Debian/Ubuntu)"
    },
    {
      "id": "dnf",
      "kind": "dnf",
      "package": "msmtp",
      "label": "Install msmtp (Fedora/RHEL)"
    }
  ]
}
