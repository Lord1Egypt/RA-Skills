{
  "$type": "color",
  "fgColor": {
    "default": {
      "$value": "{color.dark.neutral.900}",
      "$description": "主正文与标题"
    },
    "muted": {
      "$value": "{color.dark.neutral.400}",
      "$description": "次要说明、时间、元数据"
    },
    "disabled": {
      "$value": "{color.dark.neutral.300}",
      "$description": "禁用态文字与图标"
    },
    "accent": {
      "$value": "{color.dark.accent.100}",
      "$description": "链接与可交互强调文字"
    },
    "accentHover": {
      "$value": "{color.dark.accent.200}",
      "$description": "强调态 Hover / Pressed"
    },
    "onEmphasis": {
      "$value": "{color.dark.neutral.900}",
      "$description": "强调实底上的反白文字"
    },
    "onDeep": {
      "$value": "{color.dark.surface.onDeep}",
      "$description": "深图版上的文字"
    },
    "danger": {
      "$value": "{color.dark.danger.fg}",
      "$description": "错误与危险操作文字"
    },
    "success": {
      "$value": "{color.dark.success.fg}",
      "$description": "success 语义文字"
    },
    "warning": {
      "$value": "{color.dark.warning.fg}",
      "$description": "warning 语义文字"
    },
    "info": {
      "$value": "{color.dark.info.fg}",
      "$description": "info 语义文字"
    }
  },
  "bgColor": {
