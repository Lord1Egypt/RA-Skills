          "year_color": "#F2B84B"
        },
        "dashboard_style": {
          "description": "深色 BI 仪表盘风格：深蓝底 + 青蓝/紫色折线柱图 + 金色高亮数字",
          "chart_fill_colors": ["#25B7E0", "#5E3FBE", "#2FA472", "#F2B84B"]
        },
        "radial_architecture": {
          "description": "中央多层环形架构图：中心主题 + 多层圆环 + 周围功能图标",
          "center_color": "#F2B84B",
          "ring_colors": ["#0070D2", "#5E3FBE"]
        }
