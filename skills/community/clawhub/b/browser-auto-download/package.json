{
  "name": "browser-auto-download",
  "version": "1.0.6",
  "description": "Browser-automated file downloads from dynamic pages, with explicit safety controls",
  "main": "scripts/auto_download.py",
  "scripts": {
    "test": "python scripts/auto_download.py --url \"https://www.python.org/downloads/\" --acknowledge-executable",
    "test:wechat": "python scripts/auto_download.py --wechat --acknowledge-executable",
    "test:meitu": "python scripts/auto_download.py --meitu --acknowledge-executable",
    "test:eclipse": "python scripts/auto_download.py --eclipse --acknowledge-executable",
    "optimize": "python ../skills/browser-auto-download/apply-optimizations.py"
  },
  "keywords": [
    "download",
    "automation",
    "playwright",
    "browser",
    "web-scraping",
    "openclaw",
    "skill"
  ],
  "author": "OpenClaw Community",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/openclaw/browser-auto-download"
  },
  "homepage": "https://clawhub.com/skills/browser-auto-download",
  "bugs": {
    "url": "https://github.com/openclaw/browser-auto-download/issues"
  },
  "engines": {
    "python": ">=3.8"
  },
  "dependencies": {
    "playwright": "1.65.0"
  },
  "devDependencies": {}
}
