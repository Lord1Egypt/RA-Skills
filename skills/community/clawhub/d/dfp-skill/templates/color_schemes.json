      "use_cases": ["数智财务发布", "企业数字化转型", "SAP方案发布", "财务AI", "ESG碳管理", "企业级峰会"],
      "distribution": {
        "background": "65%",
        "card_background": "15%",
        "text": "15%",
        "accents": "5%"
      },
      "layout_hints": {
        "slide_ratio": "3:1（超宽）",
        "content_layout": "横向三栏分段：背景信息 → 核心视觉 → 延伸说明",
        "title_position": "顶部15%-20%高度处，居中或左对齐",
        "card_gap": "20-30px 卡片间留白",
        "margins": "上下8%-10%，左右6%-8%",
        "no_page_number": true
      }
    }
  },
  "usage_rules": {
    "max_accents_per_slide": 3,
    "min_contrast_ratio": "4.5:1",
    "color_distribution": {
      "background": "70%",
      "text": "20%",
      "accent": "10%"
    },
    "ultra_wide_rules": {
      "notes": [
        "超宽屏(21:9 / 3:1)每页信息承载量是常规16:9的1.5-1.8倍",
        "超宽屏适合横向三段式布局：左-中-右 / 左图-中流程-右数据",
        "超宽屏适合时间轴、演进图、横向流程",
        "超宽屏不适合单列长文本，应始终采用横向分布的多栏布局"
      ]
    },
    "notes": [
      "单张幻灯片最多使用 3 种强调色（不含黑白灰）",
      "保持文本与背景的最低对比度 4.5:1",
      "避免纯红+纯绿的配色组合（色盲友好）",
      "同一演示文稿使用同一配色方案",
      "数智财务风格的超宽版式建议用于企业大会/路演大屏"
    ]
  }
}
