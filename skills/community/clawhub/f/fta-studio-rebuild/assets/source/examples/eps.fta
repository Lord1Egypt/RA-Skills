# ================================================================
# EPS 电动助力转向 - 故障树分析 (FTA)
# 顶层安全目标: 非预期的助力 Unintended Assist Torque
# 范式: 对标 AB12 FTA (Isograph / FaultTree+)
# 数据来源: MOS.pdf (功率板) / Control.pdf (控制板)
#
# 建模说明:
#   1) missionTime = 5000 h (车辆寿命量级)
#   2) 底事件概率按 SN29500 / IEC 62380 器件失效率量级取值, 需按实际 FMEDA 修正
#   3) COND 事件为诊断覆盖率残余(未检出)概率, 与基础失效构成相乘关系
#   4) 五分支对应 AB12 范式中的分配门 (Allocation Gate)
#   5) AB12 中的跨页事件已内联展开为完整子树, 保证定量计算正确
# ================================================================
meta title: 非预期的助力Unintended_Assist_Torque
meta project: EPS 电动助力转向系统功能安全分析
meta standard: ISO 26262 / GB/T 34590 (ASIL D)
meta missionTime: 5000
meta author: FTA Analysis
meta date: 2026-10-15
meta description: 顶层事件为 EPS 输出轴产生非请求助力转矩。五个分配门: 电机非预期转矩 / 助力请求被接受 / 失去停转检测与响应 / 相绕组非预期能量 / 共因与潜伏失效。

TOP 非预期的助力（EPS_输出轴出现非请求助力转矩） desc="TOP EVENT。依据 ISO 26262 / GB/T ISO 26262 与整车 Item Definition：非预期助力作用于驾驶员转向盘，可能导致车辆非预期转向，按 NMEDC（Non-Malfunctioning Dangerous Event Class）中最严重的 D 等级评估。本树仅覆盖电气/电子与"
  OR
    INTER 电机产生非预期的助力转矩 [Unintended_assist_torque_generated_by_the_EPS_motor] desc="能量分配门：助力转矩最终必须由电机产生，是物理根因汇聚点。"
      OR
        INTER 相电流或换相序列错误 [Wrong_phase_current___commutation_sequence_into_motor_windings] desc="AND 门：错误的转矩指令 + 电机实际转动，二者同时满足才表现为非预期助力。"
          AND
            INTER 电流控制环输出错误（Id_Iq_给定错误） [Erroneous_current_control_loop_output_(wrong_Id_Iq_reference)] desc="见 02_REQ_ACCEPTED。"
              OR
                INTER 整车总线下发错误的助力请求 [Erroneous_assist_request_from_vehicle_bus_(CAN)] desc="Control.pdf p8/p11: CAN1..CAN6, PWM1/2, U1 P20.7 RXD0/TXD0, P20.8 RXD1/TXD1"
                  OR
                    BASIC 收到非预期的助力请求报文 [Incorrect_CAN_message_(unintended_assist_request_received)] p=6.000e-05 ref=EPS-B001 comp=CAN_PWM接口 desc="CAN1/CAN2/CAN5 (MCU1), CAN3/CAN4/CAN6 (MCU2)"
                    BASIC CAN_收发器失效___总线对电源或地对短路 [CAN_transceiver_failure___bus_short_to_VBAT_or_GND] p=6.000e-05 ref=EPS-B002 comp=CAN_PWM接口 desc="Control.pdf p17: D9102/D9103/D9104 (CAN_L/H 双 TVS), J9102"
                    BASIC PWM_输入引脚功能异常（外部助力请求线） [PWM_input_pin_malfunction_(external_assist_request_line)] p=8.000e-05 ref=EPS-B003 comp=通用电子元件 desc="Control.pdf p8: U4201A pin P33/P34 (PWM1_TS/ PWM_IN) - Page1 框图标注 PWM"
                INTER 基于错误传感器输入内部计算出错误的助力请求 [Erroneous_assist_request_computed_internally_from_wrong_sensor_input] desc="见 06_SENSORS。传感器错误是请求路径错误的根因之一。"
                  OR
                    INTER 扭矩传感器信号失效（T1_T2） [Torque_sensor_signal_failure_(T1_T2)] desc="Control.pdf p17: CHA_T2_SENT_1 (J9102A pin6), CHA_T1_SENT_1 (J9102B pin3), CHA_POS_SENT_1, C9109/C9107 (100nF), LB9102/LB9103 (3.3A, 25VDC) MOS.pdf p1框图: 6*Sin/Cos, 3*SENT"
                      OR
                        BASIC 单路扭矩信号超范围 [Single_channel_torque_signal_out_of_range] p=8.000e-05 ref=EPS-B004 comp=通用电子元件 desc="CHA_T1_SENT_1 / CHA_T2_SENT_1"
                        BASIC 双通道同向误差（合理性校验失效） [Both_channels_correlated_error_(plausibility_check_defeated)] p=7.000e-05 ref=EPS-B005 comp=ADC_采样放大器 desc="CHA_T1_SENT_1 / CHA_T2_SENT_1, VADC_5V (共用基准)"
                        COND 扭矩合理性校验未覆盖 [Torque_plausibility_not_covered] desc="依软件安全需求（待补编号）"
                    INTER 转子位置传感器失效（Sin_Cos___Resolver） [Rotor_position_sensor_failure_(Sin_Cos,_resolver)] desc="MOS.pdf p5: U7101 TAB4140-BAAB (Sensor_1); p6: U7201 TAB4140-BAAB (Sensor_2)Control.pdf p11: SINE_P_2, COSINE_P_2, INV_SINE_2, INV_COSINE_2"
                      OR
                        BASIC 单传感器失效（卡滞___偏置___增益） [Single_sensor_failure_(stuck___offset___gain)] p=8.000e-05 ref=EPS-B006 comp=基准_偏置源 desc="U7101 / U7201"
                        BASIC 共用激励或_VADC_供电失效 [Shared_excitation___VADC_supply_failure] p=1.500e-05 ref=EPS-B007 comp=电容 desc="VADC1_5V / VADC2_5V (TB7101/TB7201), C7101/C7201 (100nF 0402)"
                        BASIC Resolver_芯片自测（DIE_TEST）未执行或未评估 [Resolver_DIE_self-test_not_performed___not_evaluated] p=8.000e-05 ref=EPS-B008 comp=转子位置传感器 desc="DIE1_TEST, DIE2_TEST (U7101/U7201 pin3/14, pin3/14)"
                        COND 位置合理性校验未覆盖 [Position_plausibility_not_covered] desc="依软件安全需求（待补编号）"
                    INTER 车速或转角输入失效 [Vehicle_speed___steering_angle_input_failure] desc="Control.pdf p11: CAN1_RXD/TXD, CAN2_RXD/TXD, CAN3_RXD/TXD, PWM1_TS, PWM2; p17: CAN2_H/L, CAN2_IL, CAN1_H/L, CAN1_IL"
                      OR
                        BASIC 接受了无效的车速_转角报文 [Invalid_speed_angle_message_accepted] p=8.000e-05 ref=EPS-B009 comp=通用电子元件 desc="CAN1/CAN2/CAN3/CAN4/CAN5/CAN6, PWM1, PWM2"
                        COND 输入合理性校验未覆盖 [Input_plausibility_not_covered] desc="依软件安全需求（待补编号）"
                    INTER 温度传感器失效（过温保护被旁路） [Temperature_sensor_failure_(over-temperature_protection_bypassed)] desc="MOS.pdf p7: RT8101/RT8201 (10K ±5%), U8101/U8201 LMT86QDCKRQ1, TEMP_CNTRL_1_ADC / TEMP_CNTRL_2_ADC"
                      OR
                        BASIC NTC_开路或短路（单路） [NTC_open___short_(single_channel)] p=3.000e-05 ref=EPS-B010 comp=温度传感器NTC desc="RT8101 / RT8201"
                        BASIC LMT86_比较器失效 [LMT86_comparator_failure] p=1.000e-04 ref=EPS-B011 comp=LDO_DC-DC稳压器 desc="U8101 / U8201 (LMT86QDCKRQ1), R8102/R8202 (4.7K±1%), LB8101/LB8201 (MMZ1608D121CTDH5)"
                        COND 过温关断未覆盖 [Over-temperature_shutdown_not_covered] desc="依软件安全需求（待补编号）"
                INTER PWM_指令生成故障（6*PWM_输出至PreDrv） [Faulty_PWM_command_generation_(6*PWM_output_to_PreDrv)] desc="MOS.pdf p1框图: MCU1/MCU2 -> 6*PWM -> PreDr1/PreDrv2 -> 6*MOS; Control.pdf p8/p11: G0/G1/G2/G3 (高边), GLA/GLB/GLC/GWA/GWB/GWC (低边)"
                  OR
                    BASIC MCU_GPIO_输出恒高或_PWM_占空比错误 [MCU_GPIO_output_stuck_high___PWM_duty_error] p=1.200e-04 ref=EPS-B012 comp=MCU desc="MOS.pdf p8/p9/p11: G0/G1/G2/G3, GLA/GLB/GLC, GWA/GWB/GWC, SS1_1, SS1_2"
                    BASIC 栅极驱动器_A4918_失效 [Pre-driver_(A4918)_gate_drive_failure] p=1.000e-04 ref=EPS-B013 comp=栅极驱动器A4918 desc="MOS.pdf p8: U9101 A4918KEVSR-1A-3-T; p9: U9201 (第二路)"
                    BASIC 栅极驱动器_SPI_配置损坏 [SPI_configuration_corruption_of_gate_driver] p=1.000e-04 ref=EPS-B014 comp=栅极驱动器A4918 desc="MOS.pdf p8: MISO/MOSI/SCK/CS, TAB, CS1P/CS1M/CS1O, CS2P/CS2M/CS2O, CS3P/CS3M/CS3O"
                    BASIC 栅极线开路___栅极电阻失效 [Gate_line_open___Rg_gate_resistor_failure] p=2.500e-05 ref=EPS-B015 comp=栅极网络电阻 desc="MOS.pdf p8/p9: R9119-R9122 (15.4R ±1%), R9123-R9126 (27R ±1%), R9127/R9128 (1R), R9130 (1R ±1%), C9120-C9125 (3.3nF/4.7uF)"
                BASIC MCU_硬件损坏导致输出非预期_PWM（单点） [Hardware_damage_of_MCU_leading_to_unintended_PWM_(single_point)] p=1.200e-04 ref=EPS-B016 comp=MCU desc="Control.pdf p8: U4101A SAK-TC3SBLP-32F300FS (MCU1); p11: U4201E (MCU2)"
                INTER 安全机制被绕过___安全软件失效 [Safety_mechanism_bypassed___safety_software_failure] desc="见 08_SAFETY_SW。"
                  OR
                    INTER 安全机制的硬件测试无效 [Hardware_test_of_safety_mechanism_not_effective] desc="Control.pdf p8: HWCFG1_0/1/2/3, TP4104-TP4107, L41018A (测试点组); 表内说明: HwCFG0 EVR33 OFF / EVRC OFF / Boot from pin; HwCFG1 EVR33 ON / EVRC ON / pull-up"
                      OR
                        BASIC 配置引脚错误或悬空 [Configuration_pins_wrong___floating] p=2.500e-05 ref=EPS-B017 comp=电阻 desc="HWCFG1_0..HWCFG1_3, R4107 (4.7K 0402), R4108 (4.7K 0402)"
                        BASIC 测试执行不完整或结果未评估 [Test_execution_incomplete___result_not_evaluated] p=5.000e-05 ref=EPS-B018 comp=自测执行失效 desc="MCU1/MCU2 安全软件"
                    INTER 助力请求路径中的软件控制流错误 [Software_control-flow_error_in_torque_request_path] desc="MCU1/MCU2 软件（待补软件安全需求编号）"
                      OR
                        BASIC 转矩限制功能错误 [Torque_limiting_function_error] p=5.000e-05 ref=EPS-B019 comp=软件系统性失效 desc="MCU 软件"
                        BASIC 助力方向判定错误 [Sign_direction_determination_error] p=5.000e-05 ref=EPS-B020 comp=软件系统性失效 desc="MCU 软件"
                        BASIC 看门狗_超时处理错误 [Watchdog___timeout_handling_error] p=3.000e-05 ref=EPS-B021 comp=看门狗_时钟 desc="MCU 软件 + PMIC Watchdog"
                    INTER 检出故障后未执行故障响应 [Fault_reaction_not_executed_on_detected_fault] desc="Control.pdf p3: nERROR, nFAULT, RESET, VREG (PMIC 响应链); MOS.pdf p8: RESETn, nFAULT, DIAG, FET_DRV_Stby_1"
                      OR
                        BASIC PMIC_在_nERROR_后未进入安全态 [PMIC_does_not_enter_safe_state_on_nERROR] p=1.000e-04 ref=EPS-B022 comp=PMIC电源管理 desc="U1101 TLF35584 (nERROR pin20, VREG pin8, ENA pin3)"
                        BASIC 软件未请求停转 [Halt_path_not_requested_by_software] p=5.000e-05 ref=EPS-B023 comp=软件系统性失效 desc="MCU 软件"
            INTER 换相或_PWM_占空比序列错误 [Erroneous_commutation___PWM_duty_sequence] desc="见 02_REQ_ACCEPTED。"
              OR
                INTER 整车总线下发错误的助力请求_@1 [Erroneous_assist_request_from_vehicle_bus_(CAN)] desc="Control.pdf p8/p11: CAN1..CAN6, PWM1/2, U1 P20.7 RXD0/TXD0, P20.8 RXD1/TXD1"
                  OR
                    BASIC 收到非预期的助力请求报文_@2 [Incorrect_CAN_message_(unintended_assist_request_received)] p=6.000e-05 ref=EPS-B024 comp=CAN_PWM接口 desc="CAN1/CAN2/CAN5 (MCU1), CAN3/CAN4/CAN6 (MCU2)"
                    BASIC CAN_收发器失效___总线对电源或地对短路_@3 [CAN_transceiver_failure___bus_short_to_VBAT_or_GND] p=6.000e-05 ref=EPS-B025 comp=CAN_PWM接口 desc="Control.pdf p17: D9102/D9103/D9104 (CAN_L/H 双 TVS), J9102"
                    BASIC PWM_输入引脚功能异常（外部助力请求线）_@4 [PWM_input_pin_malfunction_(external_assist_request_line)] p=8.000e-05 ref=EPS-B026 comp=通用电子元件 desc="Control.pdf p8: U4201A pin P33/P34 (PWM1_TS/ PWM_IN) - Page1 框图标注 PWM"
                INTER 基于错误传感器输入内部计算出错误的助力请求_@5 [Erroneous_assist_request_computed_internally_from_wrong_sensor_input] desc="见 06_SENSORS。传感器错误是请求路径错误的根因之一。"
                  OR
                    INTER 扭矩传感器信号失效（T1_T2）_@6 [Torque_sensor_signal_failure_(T1_T2)] desc="Control.pdf p17: CHA_T2_SENT_1 (J9102A pin6), CHA_T1_SENT_1 (J9102B pin3), CHA_POS_SENT_1, C9109/C9107 (100nF), LB9102/LB9103 (3.3A, 25VDC) MOS.pdf p1框图: 6*Sin/Cos, 3*SENT"
                      OR
                        BASIC 单路扭矩信号超范围_@7 [Single_channel_torque_signal_out_of_range] p=8.000e-05 ref=EPS-B027 comp=通用电子元件 desc="CHA_T1_SENT_1 / CHA_T2_SENT_1"
                        BASIC 双通道同向误差（合理性校验失效）_@8 [Both_channels_correlated_error_(plausibility_check_defeated)] p=7.000e-05 ref=EPS-B028 comp=ADC_采样放大器 desc="CHA_T1_SENT_1 / CHA_T2_SENT_1, VADC_5V (共用基准)"
                        COND 扭矩合理性校验未覆盖_@9 [Torque_plausibility_not_covered] desc="依软件安全需求（待补编号）"
                    INTER 转子位置传感器失效（Sin_Cos___Resolver）_@10 [Rotor_position_sensor_failure_(Sin_Cos,_resolver)] desc="MOS.pdf p5: U7101 TAB4140-BAAB (Sensor_1); p6: U7201 TAB4140-BAAB (Sensor_2)Control.pdf p11: SINE_P_2, COSINE_P_2, INV_SINE_2, INV_COSINE_2"
                      OR
                        BASIC 单传感器失效（卡滞___偏置___增益）_@11 [Single_sensor_failure_(stuck___offset___gain)] p=8.000e-05 ref=EPS-B029 comp=基准_偏置源 desc="U7101 / U7201"
                        BASIC 共用激励或_VADC_供电失效_@12 [Shared_excitation___VADC_supply_failure] p=1.500e-05 ref=EPS-B030 comp=电容 desc="VADC1_5V / VADC2_5V (TB7101/TB7201), C7101/C7201 (100nF 0402)"
                        BASIC Resolver_芯片自测（DIE_TEST）未执行或未评估_@13 [Resolver_DIE_self-test_not_performed___not_evaluated] p=8.000e-05 ref=EPS-B031 comp=转子位置传感器 desc="DIE1_TEST, DIE2_TEST (U7101/U7201 pin3/14, pin3/14)"
                        COND 位置合理性校验未覆盖_@14 [Position_plausibility_not_covered] desc="依软件安全需求（待补编号）"
                    INTER 车速或转角输入失效_@15 [Vehicle_speed___steering_angle_input_failure] desc="Control.pdf p11: CAN1_RXD/TXD, CAN2_RXD/TXD, CAN3_RXD/TXD, PWM1_TS, PWM2; p17: CAN2_H/L, CAN2_IL, CAN1_H/L, CAN1_IL"
                      OR
                        BASIC 接受了无效的车速_转角报文_@16 [Invalid_speed_angle_message_accepted] p=8.000e-05 ref=EPS-B032 comp=通用电子元件 desc="CAN1/CAN2/CAN3/CAN4/CAN5/CAN6, PWM1, PWM2"
                        COND 输入合理性校验未覆盖_@17 [Input_plausibility_not_covered] desc="依软件安全需求（待补编号）"
                    INTER 温度传感器失效（过温保护被旁路）_@18 [Temperature_sensor_failure_(over-temperature_protection_bypassed)] desc="MOS.pdf p7: RT8101/RT8201 (10K ±5%), U8101/U8201 LMT86QDCKRQ1, TEMP_CNTRL_1_ADC / TEMP_CNTRL_2_ADC"
                      OR
                        BASIC NTC_开路或短路（单路）_@19 [NTC_open___short_(single_channel)] p=3.000e-05 ref=EPS-B033 comp=温度传感器NTC desc="RT8101 / RT8201"
                        BASIC LMT86_比较器失效_@20 [LMT86_comparator_failure] p=1.000e-04 ref=EPS-B034 comp=LDO_DC-DC稳压器 desc="U8101 / U8201 (LMT86QDCKRQ1), R8102/R8202 (4.7K±1%), LB8101/LB8201 (MMZ1608D121CTDH5)"
                        COND 过温关断未覆盖_@21 [Over-temperature_shutdown_not_covered] desc="依软件安全需求（待补编号）"
                INTER PWM_指令生成故障（6*PWM_输出至PreDrv）_@22 [Faulty_PWM_command_generation_(6*PWM_output_to_PreDrv)] desc="MOS.pdf p1框图: MCU1/MCU2 -> 6*PWM -> PreDr1/PreDrv2 -> 6*MOS; Control.pdf p8/p11: G0/G1/G2/G3 (高边), GLA/GLB/GLC/GWA/GWB/GWC (低边)"
                  OR
                    BASIC MCU_GPIO_输出恒高或_PWM_占空比错误_@23 [MCU_GPIO_output_stuck_high___PWM_duty_error] p=1.200e-04 ref=EPS-B035 comp=MCU desc="MOS.pdf p8/p9/p11: G0/G1/G2/G3, GLA/GLB/GLC, GWA/GWB/GWC, SS1_1, SS1_2"
                    BASIC 栅极驱动器_A4918_失效_@24 [Pre-driver_(A4918)_gate_drive_failure] p=1.000e-04 ref=EPS-B036 comp=栅极驱动器A4918 desc="MOS.pdf p8: U9101 A4918KEVSR-1A-3-T; p9: U9201 (第二路)"
                    BASIC 栅极驱动器_SPI_配置损坏_@25 [SPI_configuration_corruption_of_gate_driver] p=1.000e-04 ref=EPS-B037 comp=栅极驱动器A4918 desc="MOS.pdf p8: MISO/MOSI/SCK/CS, TAB, CS1P/CS1M/CS1O, CS2P/CS2M/CS2O, CS3P/CS3M/CS3O"
                    BASIC 栅极线开路___栅极电阻失效_@26 [Gate_line_open___Rg_gate_resistor_failure] p=2.500e-05 ref=EPS-B038 comp=栅极网络电阻 desc="MOS.pdf p8/p9: R9119-R9122 (15.4R ±1%), R9123-R9126 (27R ±1%), R9127/R9128 (1R), R9130 (1R ±1%), C9120-C9125 (3.3nF/4.7uF)"
                BASIC MCU_硬件损坏导致输出非预期_PWM（单点）_@27 [Hardware_damage_of_MCU_leading_to_unintended_PWM_(single_point)] p=1.200e-04 ref=EPS-B039 comp=MCU desc="Control.pdf p8: U4101A SAK-TC3SBLP-32F300FS (MCU1); p11: U4201E (MCU2)"
                INTER 安全机制被绕过___安全软件失效_@28 [Safety_mechanism_bypassed___safety_software_failure] desc="见 08_SAFETY_SW。"
                  OR
                    INTER 安全机制的硬件测试无效_@29 [Hardware_test_of_safety_mechanism_not_effective] desc="Control.pdf p8: HWCFG1_0/1/2/3, TP4104-TP4107, L41018A (测试点组); 表内说明: HwCFG0 EVR33 OFF / EVRC OFF / Boot from pin; HwCFG1 EVR33 ON / EVRC ON / pull-up"
                      OR
                        BASIC 配置引脚错误或悬空_@30 [Configuration_pins_wrong___floating] p=2.500e-05 ref=EPS-B040 comp=电阻 desc="HWCFG1_0..HWCFG1_3, R4107 (4.7K 0402), R4108 (4.7K 0402)"
                        BASIC 测试执行不完整或结果未评估_@31 [Test_execution_incomplete___result_not_evaluated] p=5.000e-05 ref=EPS-B041 comp=自测执行失效 desc="MCU1/MCU2 安全软件"
                    INTER 助力请求路径中的软件控制流错误_@32 [Software_control-flow_error_in_torque_request_path] desc="MCU1/MCU2 软件（待补软件安全需求编号）"
                      OR
                        BASIC 转矩限制功能错误_@33 [Torque_limiting_function_error] p=5.000e-05 ref=EPS-B042 comp=软件系统性失效 desc="MCU 软件"
                        BASIC 助力方向判定错误_@34 [Sign_direction_determination_error] p=5.000e-05 ref=EPS-B043 comp=软件系统性失效 desc="MCU 软件"
