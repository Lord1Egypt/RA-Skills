// GUID_DEVINTERFACE_SCM_PHYSICAL_DEVICE 4283609d-4dc2-43be-bbb4-4f15dfce2c61 (guid_devinterface_scm_physical_device)
// GUID_SCM_PD_HEALTH_NOTIFICATION 9da2d386-72f5-4ee3-8155-eca0678e3b6 (guid_scm_pd_health_notification)
