#!/usr/bin/env bash

# 路径解析（兼容容器/K8s/多环境）
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/opphub-paths.sh"
opphub_init_home
# 偶合 OppHub · 状态查询
set -e

OPPHUB_HOME="${OPPHUB_HOME:-}"  # ← 由 lib/opphub-paths.sh 解析后填入
API_BASE="${OPPHUB_API_BASE:-https://api.opphub.ruiplus.cn}"

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
RED='\033[0;31m'
NC='\033[0m'

ok()   { echo -e "${GREEN}✓ $1${NC}"; }
warn() { echo -e "${YELLOW}⚠ $1${NC}"; }
fail() { echo -e "${RED}✗ $1${NC}"; exit 1; }

STATE="$OPPHUB_HOME/state.json"

if [ ! -f "$STATE" ]; then
  fail "未登录，请先 opphub login"
fi

# ★ 修复（v1.0.16）：grep 允许冒号后空格（json.dump 默认格式有空格，潜伏 bug）
TOKEN=$(grep -oE '"opphub_token"[[:space:]]*:[[:space:]]*"[^"]*"' "$STATE" | grep -o '"[^"]*"$' | cut -d'"' -f2)
OPC_ID=$(grep -oE '"opc_id"[[:space:]]*:[[:space:]]*"[^"]*"' "$STATE" | grep -o '"[^"]*"$' | cut -d'"' -f2)

echo -e "${BLUE}━━━ 偶合状态 ━━━${NC}"
echo "OPC ID: $OPC_ID"
echo ""

# 服务端验证 token
RESP=$(curl -s "$API_BASE/api/auth/me" -H "Authorization: Bearer $TOKEN")

if echo "$RESP" | grep -q '"ok":true'; then
  ok "token 有效"
  echo "$RESP" | python3 -m json.tool
else
  # ★ 修复（v1.0.14）：区分 401 错误类型
  ERR=$(echo "$RESP" | grep -o '"error":"[^"]*"' | head -1 | cut -d'"' -f4)
  case "$ERR" in
    session_revoked)
      warn "token 已被吊销（在新设备登录过？被人登出？）"
      echo -e "${YELLOW}  → 跑 ${NC}opphub login${YELLOW} 重新登录${NC}"
      exit 1
      ;;
    token_expired)
      warn "token 已过期（30 天有效期）"
      echo -e "${YELLOW}  → 跑 ${NC}opphub login${YELLOW} 重新登录${NC}"
      exit 1
      ;;
    invalid_token)
      warn "token 无效（签名不对，可能是密钥轮换）"
      echo -e "${YELLOW}  → 跑 ${NC}opphub login${YELLOW} 重新登录${NC}"
      exit 1
      ;;
    *)
      warn "token 无效或过期（$ERR），请重新登录"
      echo -e "${YELLOW}  → 跑 ${NC}opphub login${YELLOW} 重新登录${NC}"
      exit 1
      ;;
  esac
fi
