        "$value": "{color.dark.accent.emphasis}",
        "$description": "主按钮、刊头、整块强调平涂"
      }
    },
    "deep": {
      "$value": "{color.dark.surface.deep}",
      "$description": "深图版背景（亮暗皆深）"
    },
    "success": {
      "muted": {
        "$value": "{color.dark.success.muted}",
        "$description": "success 浅色提示底"
      },
      "emphasis": {
        "$value": "{color.dark.success.emphasis}",
        "$description": "success 实底"
      }
    },
    "warning": {
      "muted": {
        "$value": "{color.dark.warning.muted}",
        "$description": "warning 浅色提示底"
      },
      "emphasis": {
        "$value": "{color.dark.warning.emphasis}",
        "$description": "warning 实底"
      }
    },
    "info": {
      "muted": {
        "$value": "{color.dark.info.muted}",
        "$description": "info 浅色提示底"
      },
      "emphasis": {
        "$value": "{color.dark.info.emphasis}",
        "$description": "info 实底"
      }
    },
    "danger": {
      "muted": {
        "$value": "{color.dark.danger.muted}",
        "$description": "危险浅色提示底"
      },
      "emphasis": {
        "$value": "{color.dark.danger.emphasis}",
