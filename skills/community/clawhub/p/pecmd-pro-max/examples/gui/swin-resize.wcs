// { UINT cbSize;    //SCROLLINFO结构体本身的字节大小
//UINT fMask;       //见下面的说明
// int nMin;           //最小滚动位置
// int nMax;         //最大滚动位置，虚拟大小，本例为 5000，可以调整
//UINT nPage;        //页面尺寸
// int nPos;               //滚动块的位置
//int nTrackPos;         //滚动块当前被拖动的位置，不能在SetScrollInfo中指定
//} SCROLLINFO; 
