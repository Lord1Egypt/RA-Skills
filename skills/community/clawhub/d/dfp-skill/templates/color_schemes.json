    "digital-finance": {
      "name": "数智财务 SAP 企业级深色风格",
      "description": "3:1 超宽屏专用。深蓝→深红渐变背景 + 红色卡片边框 + 金色光带点缀。SAP企业级发布会风格，适合财务、数字化转型、企业峰会。",
      "aspect_ratio": "3:1 超宽屏",
      "layout_style": "ultra-wide-cards",
      "background": {
        "hex": "#12244D",
        "rgb": [18, 36, 77],
        "name": "深蓝"
      },
      "background_gradient": {
        "type": "diagonal_radial",
        "stops": [
          {"position": "top", "hex": "#0A1838", "rgb": [10, 24, 56], "name": "深海军蓝"},
          {"position": "middle", "hex": "#5A0F25", "rgb": [90, 15, 37], "name": "暗红"},
