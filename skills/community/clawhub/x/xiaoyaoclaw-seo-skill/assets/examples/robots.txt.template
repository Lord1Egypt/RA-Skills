Allow: /
Disallow: /console
Disallow: /admin

User-agent: ClaudeBot
Allow: /
Disallow: /console
Disallow: /admin

User-agent: Google-Extended
Allow: /
Disallow: /console
Disallow: /admin

User-agent: Bytespider
Allow: /
Disallow: /console
Disallow: /admin

