{
  "name": "blog-read",
  "description": "A blog list retrieval skill based on the Tradebee Website Builder Open API. It is used to retrieve blog data published on the website. It supports filtering by language, blog group, or exact blog ID, paginated retrieval, and is suitable for blog display, content analysis, AI content operations, and SEO workflows.",
  "version": "2.0.2",
  "input": {
    "type": "object",
    "properties": {
      "language": {
        "type": "string",
        "description": "Required. It must be selected from `languages-get` after user confirmation. Automatic selection or system inference is not allowed."
      },
      "blog_id": {
        "type": "integer",
        "description": "Optional. Exact blog filter. Omit this field to avoid blog-ID filtering. If provided, it must be one positive integer (`> 0`). `blog_id` and `bloggroup_id` are mutually exclusive: omit both to read all blogs, or provide exactly one of them."
      },
      "bloggroup_id": {
        "type": "integer",
        "description": "Optional. Blog group filter. Omit this field to read blogs from all blog groups. If provided, it must be one positive integer (`> 0`) selected from `bloggroup-read` under the same language. `blog_id` and `bloggroup_id` are mutually exclusive: omit both to read all blogs, or provide exactly one of them."
      },
      "fields": {
        "type": "array",
        "description": "Optional. Field selection list. If omitted, all supported blog fields are returned. When returning a list to the user, include `blog_id` and `blog_url` so one ID and one preview URL are available in the final answer. Do not tell the user they must preview it; provide the preview URL so the user can decide.",
        "items": {
          "type": "string",
          "description": "Field name"
        }
      },
      "pagination": {
        "type": "object",
        "description": "Pagination settings",
        "properties": {
          "current_page": {
            "type": "integer",
            "default": 1,
            "minimum": 1,
            "description": "Current page number, starting from 1. Pagination must follow the server-returned `pagination.has_next_page` and `pagination.next_page`. Do not infer pages from `total_page` or manually increment `current_page`. When `has_next_page=true`, `next_page` must be used as the next request page number. When `has_next_page=false`, pagination requests must stop."
          },
          "page_size": {
            "type": "integer",
            "default": 5,
            "minimum": 1,
            "maximum": 10,
            "description": "Items per page, range 1-10"
          }
        },
        "required": [
          "current_page",
          "page_size"
        ]
      }
    },
    "required": [
      "language"
    ]
  },
  "output": {
    "type": "object",
    "properties": {
      "status": {
        "type": "boolean",
        "description": "Request status. `true` indicates success and `false` indicates failure."
      },
      "msg": {
        "type": "string",
        "description": "Response message"
      },
      "data": {
        "type": [
          "object",
          "null"
        ],
        "description": "Returned result, which may be `null` on failure",
        "properties": {
          "pagination": {
            "type": "object",
            "description": "Pagination result",
            "properties": {
              "current_page": {
                "type": "integer",
                "description": "Current page number"
              },
              "page_size": {
                "type": "integer",
                "description": "Items per page"
              },
              "total_page": {
                "type": "integer",
                "description": "Total number of pages"
              },
              "total_count": {
                "type": "integer",
                "description": "Total number of records"
              },
              "has_next_page": {
                "type": "boolean",
                "description": "Whether a next page exists"
              },
              "next_page": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Next page number, or `null` if there is no next page"
              }
            },
            "required": [
              "current_page",
              "page_size",
              "total_page",
              "total_count",
              "has_next_page",
              "next_page"
            ]
          },
          "list": {
            "type": "array",
            "description": "Blog data list",
            "items": {
              "type": "object",
              "properties": {
                "blog_id": {
                  "type": "integer",
                  "description": "Blog ID"
                },
                "language": {
                  "type": "string",
                  "description": "Site language code"
                },
                "group": {
                  "type": "object",
                  "description": "Blog group",
                  "properties": {
                    "bloggroup_id": {
                      "type": "integer",
                      "description": "Blog group ID"
                    },
                    "group_name": {
                      "type": "string",
                      "description": "Group name"
                    }
                  },
                  "required": [
                    "bloggroup_id",
                    "group_name"
                  ]
                },
                "publisher": {
                  "type": "string",
                  "description": "Publisher"
                },
                "publication_date": {
                  "type": "string",
                  "description": "Display publication date"
                },
                "title": {
                  "type": "string",
                  "description": "Blog title"
                },
                "images": {
                  "type": "array",
                  "description": "Blog cover image URLs",
                  "items": {
                    "type": "string",
                    "description": "URL"
                  }
                },
                "tags": {
                  "type": "array",
                  "description": "Keywords",
                  "items": {
                    "type": "string",
                    "description": "Keyword"
                  }
                },
                "summary": {
                  "type": "string",
                  "description": "Summary"
                },
                "description": {
                  "type": "string",
                  "description": "Detailed description (HTML)"
                },
                "seo": {
                  "type": "object",
                  "description": "Optimization data for the blog detail page, including title, description, and keywords",
                  "properties": {
                    "title": {
                      "type": "string",
                      "description": "Optimized title, <= 90 characters"
                    },
                    "description": {
                      "type": "string",
                      "description": "Optimized description, <= 200 characters"
                    },
                    "keywords": {
                      "type": "string",
                      "description": "Optimized keywords, up to 6 keywords separated by commas, with a total length <= 120 characters"
                    }
                  },
                  "required": [
                    "title",
                    "description",
                    "keywords"
                  ]
                },
                "blog_url": {
                  "type": "string",
                  "description": "Blog detail URL path. When the response is a list, use one returned `blog_url` as the preview URL in the final answer so the user can decide whether to preview it."
                },
                "create_time": {
                  "type": "string",
                  "format": "date-time",
                  "description": "Creation time in ISO 8601 date-time format"
                },
                "update_time": {
                  "type": "string",
                  "format": "date-time",
                  "description": "Update time in ISO 8601 date-time format"
                }
              },
              "required": []
            }
          }
        }
      }
    },
    "required": [
      "status",
      "msg"
    ]
  },
  "dependencies": {
    "language": {
      "skill": "languages-get",
      "field": "list[].language",
      "mode": "select"
    },
    "bloggroup_id": {
      "skill": "bloggroup-read",
      "field": "list[].bloggroup_id",
      "mode": "select",
      "depends_on": {
        "language": "language"
      },
      "description": "Use this only when filtering by one blog group. Do not send it together with `blog_id`."
    }
  }
}
