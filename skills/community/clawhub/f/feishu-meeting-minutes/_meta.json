{
  "name": "feishu-meeting-minutes",
  "version": "1.2.0",
  "runtime": "node",
  "requiredTools": [
    "node",
    "lark-cli",
    "pandoc",
    "xelatex"
  ],
  "recommendedFonts": [
    "Noto Sans CJK SC"
  ],
  "requiredScopes": {
    "fetch": [
      "minutes:minutes:readonly",
      "minutes:minutes.artifacts:read",
      "minutes:minutes.transcript:export",
      "vc:note:read"
    ],
    "upload": [
      "drive:file:upload"
    ]
  }
}
