{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YottaMeta/yotta-resume/data/industry-registry.schema.json",
  "title": "yotta-resume industry registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "generated_at",
    "default_industry",
    "detection",
    "extensions",
    "industries"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "contract_version": {
      "const": "1.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date"
    },
    "default_industry": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "min_high_confidence_hits",
        "ambiguity_margin"
      ],
      "properties": {
        "strategy": {
          "const": "keyword_score_v1"
        },
        "min_high_confidence_hits": {
          "type": "integer",
          "minimum": 1
        },
        "ambiguity_margin": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow_new_profiles",
        "required_fields"
      ],
      "properties": {
        "allow_new_profiles": {
          "const": true
        },
        "required_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "industries": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "display_name",
          "keywords",
          "evidence_dimensions",
          "question_dimensions",
          "role_map_ref",
          "is_fallback"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "keywords": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_dimensions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "question_dimensions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "role_map_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "is_fallback": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
