{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "edl",
  "type": "object",
  "required": [
    "schema",
    "stage",
    "project_id",
    "engine",
    "clips",
    "subtitles",
    "audio",
    "output"
  ],
  "properties": {
    "schema": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "stage": {
      "enum": [
        "edl"
      ]
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "upstream": {
      "type": "object",
      "description": "{上游文件名: sha256前12位}，用于失效检测"
    },
    "engine": {
      "enum": [
        "ffmpeg",
        "remotion",
        "hyperframes"
      ]
    },
    "clips": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "order",
          "cut_id",
          "source",
          "in_sec",
          "out_sec",
          "reason"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "cut_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_\\-]+$"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "in_sec": {
            "type": "number",
            "minimum": 0
          },
          "out_sec": {
            "type": "number",
            "minimum": 0
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "transition": {
            "type": "string"
          },
          "speed": {
            "type": "number"
          }
        }
      },
      "minItems": 1
    },
    "subtitles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "beat_id",
          "text",
          "start_sec",
          "end_sec"
        ],
        "properties": {
          "beat_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_\\-]+$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "start_sec": {
            "type": "number"
          },
          "end_sec": {
            "type": "number"
          }
        }
      }
    },
    "overlays": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "start_sec",
          "end_sec"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "start_sec": {
            "type": "number"
          },
          "end_sec": {
            "type": "number"
          },
          "spec": {
            "type": "object"
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "required": [
        "target_lufs",
        "fade_ms"
      ],
      "properties": {
        "target_lufs": {
          "type": "number"
        },
        "true_peak_db": {
          "type": "number"
        },
        "fade_ms": {
          "type": "number"
        },
        "music": {
          "type": "string"
        },
        "measured_lufs": {
          "type": "number"
        }
      }
    },
    "output": {
      "type": "object",
      "required": [
        "video"
      ],
      "properties": {
        "video": {
          "type": "string",
          "minLength": 1
        },
        "srt": {
          "type": "string"
        },
        "poster": {
          "type": "string"
        },
        "measured_duration_sec": {
          "type": "number"
        }
      }
    }
  }
}