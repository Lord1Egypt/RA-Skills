  "changelog": [
    {
      "version": "1.0.0",
      "date": "2024-04-04",
      "changes": [
        "Initial secure release",
        "OAuth 2.0 authorization flow implementation",
        "Credential isolation (environment variables only)",
        "Multi-service support (Gmail, Drive, Calendar, Sheets, Docs, Contacts)",
        "Input validation (email, file paths, data sanitization)",
        "Audit logging with complete action trail",
        "Rate limiting (service-specific limits)",
        "Granular permissions (3 levels: readonly, restricted, full)",
        "Two-factor confirmation for dangerous operations",
        "HTTPS enforcement",
        "Setup validation and OAuth scripts"
