{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DeepShareAI/ClawSkills/javis-access-broker/references/submit-answer.schema.json",
  "title": "access_submit_answer arguments",
  "description": "Arguments of the access_submit_answer broker tool (agent-access contract section 7). javis-server's answer check is the authority; this schema mirrors its static rules (slice membership and excerpt windows are checked server-side only).",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision"],
  "properties": {
    "decision": { "enum": ["answer", "ask_agent", "decline"] },
    "kind": { "enum": ["summary", "exact"] },
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "sources"],
        "properties": {
          "text": { "type": "string", "minLength": 1, "maxLength": 600 },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^s[0-9]+$" }
          }
        }
      }
    },
    "exact_segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "segs"],
        "properties": {
          "source": { "type": "string", "pattern": "^s[0-9]+$" },
          "segs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^g[0-9]+$" }
          }
        }
      }
    },
    "question_for_agent": { "type": "string", "minLength": 1, "maxLength": 300 },
    "task_kind": { "enum": ["drafting_replies", "scheduling", "reminders", "summarizing", "research", "other"] },
    "topic": { "type": "string", "minLength": 1, "maxLength": 80 },
    "decline_reason": { "type": "string", "minLength": 1, "maxLength": 200 }
  },
  "allOf": [
    {
      "if": { "properties": { "decision": { "const": "answer" } }, "required": ["decision"] },
      "then": {
        "required": ["kind", "points", "task_kind", "topic"],
        "properties": { "points": { "minItems": 1 } }
      }
    },
    {
      "if": {
        "properties": { "decision": { "const": "answer" }, "kind": { "const": "exact" } },
        "required": ["decision", "kind"]
      },
      "then": {
        "required": ["exact_segments"],
        "properties": { "exact_segments": { "minItems": 1 } }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "summary" } }, "required": ["kind"] },
      "then": { "not": { "required": ["exact_segments"] } }
    },
    {
      "if": { "properties": { "decision": { "const": "ask_agent" } }, "required": ["decision"] },
      "then": { "required": ["question_for_agent"] }
    }
  ]
}
