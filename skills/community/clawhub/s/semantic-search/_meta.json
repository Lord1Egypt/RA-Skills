  "requirements": "requirements.txt",
  "env": {
    "FLIGHT_DB_HOST": "FlightSQL 数据库主机地址",
    "FLIGHT_DB_PORT": "FlightSQL 数据库端口",
    "FLIGHT_DB_USER": "数据库用户名",
    "FLIGHT_DB_PASSWORD": "数据库密码",
    "LLM_API_KEY": "LLM API 密钥",
    "EMBEDDING_API_KEY": "Embedding API 密钥（可选）"
  }
