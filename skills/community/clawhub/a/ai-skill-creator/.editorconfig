# Editor configuration for ai-company
# See https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{md,json,yaml,yml}]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

# PowerShell scripts target Windows tooling, which expects CRLF by convention
[*.ps1]
indent_style = space
indent_size = 2
end_of_line = crlf
