temp/
slides/
output/
*_images/

# Browser profiles and cached sessions (Never commit cookies or profiles)
*profile*
*session*
*.db
*.sqlite
*.sqlite3
Cookies*
Network*

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
