    "requires": {
      "bins": [],
      "env": [
        "GOOGLE_API_KEY",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "GOOGLE_REDIRECT_URI"
      ],
      "node": ">=18.0.0"
