# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/

# 临时产物 / 编辑器残留
.tmp_pdf/
*.tmp
*~
~$*
*.bak

# 项目中产生的实际 docx / json（不进入版本库，用 .workbuddy/<项目> 的资料库）
*.docx
!tools/**/*.docx
!examples/**/*.docx
# 中专教案模板（源资产，需纳入版本库；不属于生成产物）
!templates/中专教案模板.docx

# 用户/凭据
.env
*.token
*.pem

