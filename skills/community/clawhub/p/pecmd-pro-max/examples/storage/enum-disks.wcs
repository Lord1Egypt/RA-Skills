// GUID_DEVINTERFACE_CDROM 53f56308-b6bf-11d0-94f2-00a0c91efb8b (guid_devinterface_cdrom)
// GUID_DEVINTERFACE_PARTITION 53f5630a-b6bf-11d0-94f2-00a0c91efb8b (guid_devinterface_partition)
// GUID_DEVINTERFACE_TAPE 53f5630b-b6bf-11d0-94f2-00a0c91efb8b (guid_devinterface_tape)
