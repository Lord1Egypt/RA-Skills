{
  "name": "ingest_document",
  "version": "3.0.0",
  "description": "Ingest one daily document/link/message into personal or team KB.",
  "author": "mayidan",
  "language": "python3",
  "entry": "SKILL.md",
  "part_of": "paper-kb-v3",
  "requires": {
    "env": [
      "GITEA_URL",
      "GITEA_ADMIN_TOKEN"
    ],
    "context": [
      "SenderId",
      "ChatType",
      "GroupSubject",
      "MessageSid",
      "MessageThreadId",
      "AccountId",
      "CardActionValue",
      "CardFormValues",
      "WasMentioned",
      "MediaPath",
      "MediaType"
    ]
  }
}
