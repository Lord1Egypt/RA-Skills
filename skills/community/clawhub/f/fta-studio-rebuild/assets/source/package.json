{
  "name": "fta-studio",
  "version": "1.0.0",
  "description": "故障树分析工具 — 对标 Ansys medini analyze FTA 模块",
  "type": "module",
  "main": "src/api.mjs",
  "exports": {
    ".": "./src/api.mjs",
    "./api": "./src/api.mjs",
    "./model": "./src/model.mjs",
    "./mocus": "./src/mocus.mjs",
    "./bdd": "./src/bdd.mjs",
    "./quantify": "./src/quantify.mjs",
    "./layout": "./src/layout.mjs",
    "./svg": "./src/svg.mjs",
    "./report": "./src/report.mjs"
  },
  "bin": {
    "fta": "./src/cli.mjs"
  },
  "scripts": {
    "serve": "node src/cli.mjs serve",
    "test": "node test/run-tests.mjs",
    "cli": "node src/cli.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "fault-tree-analysis",
