{
  "name": "session-sync-detect",
  "displayName": "Session Sync Detect",
  "summary": "跨会话同步检测与询问技能",
  "description": "当用户谈到当前 session 没有的事情时，自动检测并询问是否进行跨会话同步",
  "version": "0.1.0",
  "author": "郭泉 (Dr. Guo) 🎯",
  "license": "MIT-0",
  "tags": ["session", "memory", "sync", "detect"],
  "config": {
    "requiredPaths": [],
    "optionalPaths": [
      "~/.openclaw/workspace/memory/*.md",
      "~/.openclaw/workspace/MEMORY.md"
    ]
  },
  "capabilities": {
    "readSessionHistory": true,
    "searchMemoryFiles": true,
    "writeMemoryFiles": true
  },
  "security": {
    "requiresUserConfirmation": true,
    "autoDetect": true,
    "silentExecution": false
  }
}
