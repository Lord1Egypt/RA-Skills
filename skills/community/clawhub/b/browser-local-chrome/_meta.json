{
  "name": "browser-local-chrome",
  "version": "1.1.0",
  "description": "本地 Chrome 调试模式浏览器自动化配置（跨平台）",
  "author": "Like Liu",
  "license": "MIT",
  "scripts": [
    "scripts/start-chrome.js",
    "scripts/configure-browser.js",
    "scripts/check-status.js",
    "scripts/stop-chrome.js",
    "scripts/setup.js",
    "scripts/troubleshoot.js"
  ],
  "config": {
    "cdpPort": 9222,
    "userDataDir": {
      "win32": "C:\\chrome-debug-profile",
      "darwin": "~/chrome-debug-profile",
      "linux": "~/chrome-debug-profile"
    },
    "chromePath": {
      "win32": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
      "darwin": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
      "linux": "/usr/bin/google-chrome"
    }
  },
  "platforms": ["win32", "darwin", "linux"],
  "requirements": [
    "Google Chrome 浏览器已安装",
    "Node.js 14+",
    "OpenClaw 2026.4.0+"
  ]
}
